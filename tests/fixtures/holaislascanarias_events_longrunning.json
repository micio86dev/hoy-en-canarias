{"jsonapi":{"version":"1.0","meta":{"links":{"self":{"href":"http:\/\/jsonapi.org\/format\/1.0\/"}}}},"data":[{"type":"node--event","id":"ecd0ca9b-a5cd-4013-ad65-50f66ae9f1d5","links":{"self":{"href":"https:\/\/www.holaislascanarias.com\/jsonapi\/node\/event\/ecd0ca9b-a5cd-4013-ad65-50f66ae9f1d5?resourceVersion=id%3A1093516"},"working-copy":{"href":"https:\/\/www.holaislascanarias.com\/jsonapi\/node\/event\/ecd0ca9b-a5cd-4013-ad65-50f66ae9f1d5?resourceVersion=rel%3Aworking-copy"}},"attributes":{"title":"Trail Pino Santo","changed":"2026-09-03T15:08:01+00:00","path":{"alias":"\/eventos\/gran-canaria\/trail-pino-santo","pid":793840,"langcode":"es"},"field_event_city":"Santa Br\u00edgida","field_event_description":"El Trail Pino Santo es una carrera de monta\u00f1a de 12 km que combina deporte y naturaleza en un entorno espectacular. Adem\u00e1s, incluye una ruta de senderismo guiado de 8-9 km, ideal para quienes prefieren un ritmo m\u00e1s relajado. Este evento ofrece a los participantes la oportunidad de disfrutar del paisaje monta\u00f1oso mientras recorren parte del Paisaje Protegido de Pino Santo. Organizado por una asociaci\u00f3n vecinal dentro del Proyecto Social de Recuperaci\u00f3n del Patrimonio Caminero, busca preservar y dar a conocer este entorno natural desde 2023.","field_event_free":"0","field_event_latitude":"28.035952","field_event_longitude":"-15.497250","field_event_tickets_website":null,"field_event_website":{"uri":"https:\/\/trailpinosanto.com\/","title":"Trail Pino Santo website","options":{"attributes":{"target":"_blank"}}},"field_e_calculated_end_date":"2026-12-06","field_e_end_date":"2026-12-06","field_e_start_date":"0026-12-06"},"relationships":{"field_event_category":{"data":{"type":"taxonomy_term--event_category","id":"aa99a904-4040-4aa9-b807-510006f3bddc","meta":{"drupal_internal__target_id":31}},"links":{"related":{"href":"https:\/\/www.holaislascanarias.com\/jsonapi\/node\/event\/ecd0ca9b-a5cd-4013-ad65-50f66ae9f1d5\/field_event_categor