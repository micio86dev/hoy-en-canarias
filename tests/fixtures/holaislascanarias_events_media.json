  {
   "type": "node--event",
   "id": "f2da303e-e102-4266-9724-683b59fe4e82",
   "attributes": {
    "title": "Fiestas de la Caña Dulce y La Concepción",
    "changed": "2026-10-06T15:08:01+00:00",
    "path": {
     "alias": "/eventos/gran-canaria/fiestas-de-la-cana-dulce-y-la-concepcion",
     "pid": 821377,
     "langcode": "es"
    },
    "field_event_city": "Jinámar",
    "field_event_description": "Las Fiestas de la Caña Dulce y La Concepción en Jinámar, Gran Canaria, son una celebración tradicional en honor a la Inmaculada Concepción y están declaradas Fiesta de Interés Turístico. Este evento combina actividades culturales, deportivas y religiosas, incluyendo el pregón inaugural, conciertos, muestras de artesanía, degustaciones de productos locales y la popular \"Gran Chupada\" de caña dulce. Además, se realizan exhibiciones de juegos tradicionales y lucha canaria, conciertos de grupos tradicionales y fuegos artificiales, destacando la riqueza cultural y el sentido de comunidad de este histórico festejo.",
    "field_event_free": "1",
    "field_event_latitude": "28.031474",
    "field_event_longitude": "-15.409210",
