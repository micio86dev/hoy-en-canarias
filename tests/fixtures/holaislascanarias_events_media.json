   "attributes": {
    "title": "Trail Pino Santo",
    "changed": "2026-09-03T15:08:01+00:00",
    "path": {
     "alias": "/eventos/gran-canaria/trail-pino-santo",
     "pid": 793840,
     "langcode": "es"
    },
    "field_event_city": "Santa Brígida",
    "field_event_description": "El Trail Pino Santo es una carrera de montaña de 12 km que combina deporte y naturaleza en un entorno espectacular. Además, incluye una ruta de senderismo guiado de 8-9 km, ideal para quienes prefieren un ritmo más relajado. Este evento ofrece a los participantes la oportunidad de disfrutar del paisaje montañoso mientras recorren parte del Paisaje Protegido de Pino Santo. Organizado por una asociación vecinal dentro del Proyecto Social de Recuperación del Patrimonio Caminero, busca preservar y dar a conocer este entorno natural desde 2023.",
    "field_event_free": "0",
    "field_event_latitude": "28.035952",
