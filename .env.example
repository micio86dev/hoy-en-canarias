# Copy to .env and adjust. Never commit real values.

# --- Importer (canarias-events) ---
TICKETMASTER_API_KEY=
CANARIAS_DB_PATH=data/events.sqlite

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=hoy
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=hoy
POSTGRES_HOST_PORT=55432
POSTGRES_TEST_HOST_PORT=55433

# --- API (HOY_*) ---
HOY_DATABASE_URL=postgresql+psycopg://hoy:change-me-locally@localhost:55432/hoy
HOY_SITE_URL=http://localhost:3000
HOY_CORS_ORIGINS=http://localhost:3000
# Leave unset to disable the admin import endpoint. Never a blank value.
# HOY_ADMIN_TOKEN=
HOY_RATE_LIMIT_PER_MINUTE=120
HOY_IMPORTER_COMMAND=canarias-events
HOY_IMPORTER_DB_PATH=data/events.sqlite
HOY_IMPORTER_TIMEOUT_SECONDS=900
HOY_IMPORT_WINDOW_DAYS=60
HOY_IMPORT_MAX_ATTEMPTS=2
HOY_IMPORT_RETRY_BACKOFF_SECONDS=60

# --- Web (Nuxt). NUXT_PUBLIC_SITE_URL is read at BUILD time for canonical and hreflang URLs. ---
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_API_BASE=http://localhost:8000
# Map tiles. The default OpenStreetMap server is for development only; use a provider you contract.
NUXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Compose host ports ---
API_HOST_PORT=8000
WEB_HOST_PORT=3000
